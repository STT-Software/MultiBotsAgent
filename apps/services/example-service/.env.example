# Variables de entorno para el servicio en desarrollo local.
# Copiar a .env y completar con los valores reales.
#
# Estas variables conectan el servicio local a los recursos
# compartidos de AWS del entorno dev.

NODE_ENV=development
PORT=3001

# AWS
AWS_REGION=us-east-1

# Base de datos (completar según el motor elegido)
# MONGO_URI=mongodb://...
# DATABASE_URL=postgresql://...

# Otros recursos de AWS (completar según necesidad)
# S3_BUCKET_NAME=todo-list-poc-dev-mainbucket
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/...
