    "migrate": "npx tsx src/migrations/create-indexes.ts"
  },
  "dependencies": {
    "@multibotagents/types": "workspace:*",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@multibotagents/config": "workspace:*",
    "@types/node": "^25.7.0",
    "vitest": "^3.2.4"
  }
