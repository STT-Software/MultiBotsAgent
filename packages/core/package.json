{
  "name": "@multibotagents/core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "email-verification": ["./dist/email-verification/index.d.ts"],
      "whatsapp": ["./dist/whatsapp/index.d.ts"],
      "memory": ["./dist/memory/index.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./email-verification": {
      "types": "./dist/email-verification/index.d.ts",
      "default": "./dist/email-verification/index.js"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp/index.d.ts",
      "default": "./dist/whatsapp/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "transit": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "test": "vitest --run"
  },
  "dependencies": {
    "@multibotagents/types": "workspace:*",
    "@langchain/core": "^1.1.47",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@multibotagents/config": "workspace:*",
    "@multibotagents/db": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "fast-check": "^4.8.0",
    "mongodb": "6.12.0",
    "vitest": "^3.2.4"
  }
}
